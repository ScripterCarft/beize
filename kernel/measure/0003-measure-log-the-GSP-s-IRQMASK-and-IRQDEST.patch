From 03460f7bda8f757b4cb980f3cdda5d30e92812b5 Mon Sep 17 00:00:00 2001
From: Joe Finzel <joe@sudmix.de>
Date: Fri, 23 Oct 2026 10:57:51 +0200
Subject: [PATCH] measure: log the GSP's IRQMASK and IRQDEST

Measurement only, not for upstream: whether 0x00040000 is routed to the
host or to the GSP.
---
 drivers/gpu/drm/nouveau/nvkm/subdev/gsp/rm/r535/gsp.c | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/drivers/gpu/drm/nouveau/nvkm/subdev/gsp/rm/r535/gsp.c b/drivers/gpu/drm/nouveau/nvkm/subdev/gsp/rm/r535/gsp.c
index 463e463db24..c65cf097f23 100644
--- a/drivers/gpu/drm/nouveau/nvkm/subdev/gsp/rm/r535/gsp.c
+++ b/drivers/gpu/drm/nouveau/nvkm/subdev/gsp/rm/r535/gsp.c
@@ -67,6 +67,15 @@ r535_gsp_intr(struct nvkm_inth *inth)
 	u32 dest = nvkm_falcon_rd32(&gsp->falcon, gsp->falcon.func->addr2 +
 						  gsp->falcon.func->riscv_irqdest);
 	u32 stat = intr & inte & dest;
+	static bool shown;
+
+	if (!shown) {
+		shown = true;
+		nvkm_info(subdev, "measure: irqmask %08x irqdest %08x\n", inte, dest);
+	}
+	if (intr & inte & ~dest)
+		nvkm_info(subdev, "measure: GSP's own intr %08x left alone\n",
+			  intr & inte & ~dest);
 
 	if (!stat) {
 		nvkm_debug(subdev, "inte %08x %08x\n", intr, inte);
-- 
2.53.0

