# Real hardware, starting with the owner's PC (CLAUDE.md §2): ASUS ROG Strix
# Z790-F (Intel 700 chipset), i7-13700K, NVIDIA graphics card. Applied after
# beize-base.config; every option is verified after merging. Drivers are
# built in: Beize ships no kernel modules.

# Storage: NVMe SSDs (SATA/AHCI, e.g. the Samsung 860 EVO, is in defconfig)
CONFIG_BLK_DEV_NVME=y

# Network: Intel I225/I226 2.5GbE, the LAN controller of Z790 boards
CONFIG_IGC=y

# Screen: keep the framebuffer the firmware set up (the GOP of the graphics
# card) as console until a real GPU driver takes over, so everything early –
# the recovery-key prompt above all – is on the monitor, not just a serial port.
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FRAMEBUFFER_CONSOLE=y

# CPU: Intel C-states for idle power
CONFIG_INTEL_IDLE=y
