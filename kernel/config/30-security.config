# Security (ADR 0015), on top of the upstream hardening fragments.

# Lockdown "integrity", always: not even root can change the running kernel
# (no unsigned modules, no /dev/mem, no unsigned kexec). Beize always boots
# with Secure Boot; Fedora and Ubuntu enable it exactly then.
CONFIG_SECURITY=y
CONFIG_SECURITYFS=y
CONFIG_SECURITY_LOCKDOWN_LSM=y
CONFIG_SECURITY_LOCKDOWN_LSM_EARLY=y
CONFIG_LOCK_DOWN_KERNEL_FORCE_INTEGRITY=y
# Landlock (unprivileged sandboxing), Yama (ptrace scope), BPF LSM (systemd)
CONFIG_SECURITY_LANDLOCK=y
CONFIG_SECURITY_YAMA=y
CONFIG_BPF_LSM=y
CONFIG_LSM="lockdown,yama,bpf,landlock"
CONFIG_KEYS=y

# Exceptions from the upstream hardening fragment, each with its reason:
# - kernel CFI and stack erasing need clang (or gcc plugins, which Beize does
#   not build); Fedora goes without both too
# CONFIG_CFI is not set
# CONFIG_KSTACK_ERASE is not set
# - no /dev/mem at all instead of a restricted one: nothing in Beize uses it
#   (lockdown would block it anyway)
# CONFIG_DEVMEM is not set
# CONFIG_STRICT_DEVMEM is not set
# CONFIG_IO_STRICT_DEVMEM is not set

# TPM 2.0: unlocks the root partition and seeds the RNG; built in like Fedora.
# CRB = Intel PTT and QEMU tpm-crb, TIS = discrete TPMs.
CONFIG_TCG_TPM=y
CONFIG_TCG_TIS=y
CONFIG_TCG_CRB=y
CONFIG_HW_RANDOM=y
CONFIG_HW_RANDOM_TPM=y
# Encrypted kernel-TPM sessions: off until it costs no boot time (CLAUDE.md §10)
# CONFIG_TCG_TPM2_HMAC is not set

# Shadow stacks for programs (ADR 0014)
CONFIG_X86_USER_SHADOW_STACK=y

# Crypto: LUKS2 default cipher aes-xts-plain64, hardware accelerated;
# libcryptsetup decrypts the keyslot area through the kernel crypto API
CONFIG_CRYPTO_AES_NI_INTEL=y
CONFIG_CRYPTO_XTS=y
CONFIG_CRYPTO_SHA256=y
CONFIG_CRYPTO_SHA512=y
CONFIG_CRYPTO_USER_API_HASH=y
CONFIG_CRYPTO_USER_API_SKCIPHER=y
