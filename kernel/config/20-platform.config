# x86-64 platform: CPUs, firmware interfaces, power management, PCI (ADR 0015).

# CPUs: Intel and AMD with x86-64-v3 (ADR 0014); allnoconfig alone is 32-bit
CONFIG_64BIT=y
CONFIG_SMP=y
CONFIG_NR_CPUS=512
CONFIG_X86_X2APIC=y
CONFIG_CPU_SUP_INTEL=y
CONFIG_CPU_SUP_AMD=y
CONFIG_X86_MCE=y
CONFIG_X86_MCE_INTEL=y
CONFIG_X86_MCE_AMD=y
CONFIG_MICROCODE=y
# Spectre, Meltdown and the like: every mitigation the kernel has
CONFIG_CPU_MITIGATIONS=y
# Memory protection keys (used e.g. by JIT engines), split-lock detection
CONFIG_X86_INTEL_MEMORY_PROTECTION_KEYS=y
CONFIG_X86_BUS_LOCK_DETECT=y
# MSR access for measuring tools (turbostat), as Fedora
CONFIG_X86_MSR=y
CONFIG_HPET_TIMER=y

# Firmware: UEFI only, the kernel is a Unified Kernel Image
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_EFIVAR_FS=y
# The EFI stub honours the firmware's memory attributes (W^X before the kernel)
CONFIG_EFI_DXE_MEM_ATTRIBUTES=y
CONFIG_DMIID=y
# systemd reads credentials passed by the hypervisor from SMBIOS type 11
CONFIG_DMI_SYSFS=y
# Kernel crash logs survive in EFI variables (systemd-pstore collects them);
# off by default, enable with efi_pstore.pstore_disable=0, as Fedora
CONFIG_PSTORE=y
CONFIG_EFI_VARS_PSTORE=m
CONFIG_EFI_VARS_PSTORE_DEFAULT_DISABLE=y

# ACPI: power button for systemd-logind, fans, thermal zones, hardware errors
CONFIG_ACPI=y
CONFIG_ACPI_BUTTON=y
CONFIG_ACPI_EC=y
CONFIG_ACPI_PRMT=y
CONFIG_ACPI_FAN=y
CONFIG_ACPI_PROCESSOR=y
CONFIG_ACPI_THERMAL=y
CONFIG_ACPI_APEI=y
CONFIG_ACPI_APEI_GHES=y
# Hardware clock: /dev/rtc0 for systemd and ntpd-rs; the kernel writes the
# synchronized time back every 11 minutes (ADR 0012)
CONFIG_RTC_CLASS=y
CONFIG_RTC_INTF_DEV=y
CONFIG_RTC_INTF_SYSFS=y
CONFIG_RTC_SYSTOHC=y
CONFIG_RTC_DRV_CMOS=y

# Power management: standby; no hibernation (lockdown forbids it, ADR 0015)
CONFIG_PM=y
CONFIG_SUSPEND=y
# /sys/power/pm_debug_messages etc. for standby problems, as Fedora
CONFIG_PM_DEBUG=y
CONFIG_PM_SLEEP_DEBUG=y
# CONFIG_HIBERNATION is not set
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y
CONFIG_X86_INTEL_PSTATE=y
CONFIG_X86_AMD_PSTATE=y
# Fallback where the firmware offers no CPPC (AMD with CPPC off, VMs)
CONFIG_X86_ACPI_CPUFREQ=y
CONFIG_CPU_FREQ_GOV_PERFORMANCE=y
CONFIG_CPU_FREQ_GOV_POWERSAVE=y
CONFIG_CPU_IDLE=y
CONFIG_CPU_IDLE_GOV_MENU=y
CONFIG_CPU_IDLE_GOV_TEO=y
CONFIG_INTEL_IDLE=y

# PCI Express with the port services every distribution enables: native
# hot plug, error reporting and containment, slot information from ACPI
CONFIG_PCI=y
# Extended configuration space (ECAM): AER, DPC and other capabilities live there
CONFIG_PCI_MMCONFIG=y
CONFIG_PCIEPORTBUS=y
CONFIG_HOTPLUG_PCI=y
CONFIG_HOTPLUG_PCI_PCIE=y
CONFIG_HOTPLUG_PCI_ACPI=y
CONFIG_ACPI_PCI_SLOT=y
CONFIG_PCIEAER=y
CONFIG_PCIE_DPC=y
CONFIG_PCIE_PTM=y
CONFIG_PCIEASPM=y
CONFIG_IRQ_REMAP=y

# Running as a guest: the VMs bz tests in (KVM)
CONFIG_HYPERVISOR_GUEST=y
CONFIG_PARAVIRT=y
CONFIG_PARAVIRT_SPINLOCKS=y
CONFIG_KVM_GUEST=y
CONFIG_HALTPOLL_CPUIDLE=y
# QEMU's firmware configuration files: systemd reads credentials from there,
# bz smoke passes test files
CONFIG_FW_CFG_SYSFS=m
