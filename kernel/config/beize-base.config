# Beize base kernel configuration fragment.
# Applied on top of x86_64 defconfig + kvm_guest.config. Every option listed
# here is verified after merging; bz fails if Kconfig silently drops one.

CONFIG_LOCALVERSION="-beize"
# CONFIG_LOCALVERSION_AUTO is not set

# Boot: the kernel is shipped as a Unified Kernel Image
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_EFI_PARTITION=y
CONFIG_EFIVAR_FS=y
# The UKI carries a zstd-compressed systemd initrd
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_ZSTD=y

# /usr: read-only EROFS image, LZ4 compressed; /: ext4, created on first boot
CONFIG_EROFS_FS=y
CONFIG_EROFS_FS_ZIP=y
CONFIG_EXT4_FS=y

# Device mapper: dm-verity protects /usr, dm-crypt encrypts the root (LUKS2)
CONFIG_MD=y
CONFIG_BLK_DEV_DM=y
CONFIG_DM_VERITY=y
CONFIG_DM_CRYPT=y
CONFIG_CRYPTO_SHA256=y
# LUKS2 default cipher aes-xts-plain64, hardware accelerated; libcryptsetup
# decrypts the keyslot area through the kernel crypto API
CONFIG_CRYPTO_XTS=y
CONFIG_CRYPTO_AES_NI_INTEL=y
CONFIG_CRYPTO_USER_API_SKCIPHER=y

# TPM 2.0: unlocks the root partition. CRB = Intel PTT and QEMU tpm-crb,
# TIS = discrete TPMs. securityfs exposes the firmware event log.
CONFIG_TCG_TPM=y
CONFIG_TCG_TIS=y
CONFIG_TCG_CRB=y
CONFIG_HW_RANDOM_TPM=y
CONFIG_SECURITYFS=y

# Requirements of systemd
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_CGROUPS=y
CONFIG_FHANDLE=y
CONFIG_INOTIFY_USER=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EPOLL=y
CONFIG_AUTOFS_FS=y
CONFIG_DMIID=y
# systemd reads credentials passed by the hypervisor from SMBIOS type 11
CONFIG_DMI_SYSFS=y
CONFIG_SECCOMP=y
# Per-service network firewalling (IPAddressDeny= etc., used by journald)
CONFIG_BPF_SYSCALL=y
CONFIG_CGROUP_BPF=y

# Console
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_PRINTK_TIME=y
