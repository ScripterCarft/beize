# Networking (ADR 0011, 0015). Network cards are modules.

CONFIG_NET=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_IPV6=y
# Multicast: local discovery (mDNS, printers)
CONFIG_IP_MULTICAST=y
CONFIG_SYN_COOKIES=y
CONFIG_INET_DIAG=m
# Fair queuing with controlled delay against bufferbloat, as Fedora
CONFIG_NET_SCHED=y
CONFIG_NET_SCH_FQ_CODEL=y
CONFIG_NET_SCH_DEFAULT=y
CONFIG_DEFAULT_FQ_CODEL=y
# Byte queue limits (latency under load) and receive packet steering
CONFIG_BQL=y
CONFIG_RPS=y

CONFIG_NETDEVICES=y
CONFIG_NET_CORE=y
# Link settings for systemd-networkd
CONFIG_ETHTOOL_NETLINK=y
CONFIG_ETHERNET=y
# Intel I225/I226 2.5GbE, the LAN controller of Z790 boards
CONFIG_NET_VENDOR_INTEL=y
CONFIG_IGC=m
CONFIG_VIRTIO_NET=m
