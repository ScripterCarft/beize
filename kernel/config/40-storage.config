# Disks and filesystems (ADR 0015). Built in: what every boot needs whatever
# the disk – device mapper and filesystems. Disk controllers are modules; the
# initrd carries them.

CONFIG_BLOCK=y
CONFIG_BLK_DEV=y
CONFIG_EFI_PARTITION=y
CONFIG_MSDOS_PARTITION=y
# I/O: mq-deadline for SATA (NVMe needs no scheduler); io.cost so systemd can
# weigh I/O between services and apps (IOWeight=)
CONFIG_MQ_IOSCHED_DEADLINE=y
CONFIG_BLK_CGROUP_IOCOST=y

# Device mapper: dm-verity protects /usr, dm-crypt encrypts the root (LUKS2)
CONFIG_MD=y
CONFIG_BLK_DEV_DM=y
CONFIG_DM_VERITY=y
CONFIG_DM_CRYPT=y

# Controllers: NVMe, SATA (AHCI), Intel VMD (NVMe behind the chipset's RAID
# function), virtio in VMs; USB sticks
CONFIG_BLK_DEV_NVME=m
CONFIG_SCSI=m
CONFIG_BLK_DEV_SD=m
CONFIG_ATA=m
CONFIG_SATA_AHCI=m
CONFIG_VMD=m
CONFIG_VIRTIO_BLK=m
CONFIG_USB_STORAGE=m
CONFIG_USB_UAS=m
CONFIG_BLK_DEV_LOOP=m

# Filesystems: /usr is EROFS (LZ4), / is ext4; the ESP and USB sticks are FAT
# or exFAT
CONFIG_EROFS_FS=y
CONFIG_EROFS_FS_ZIP=y
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_VFAT_FS=m
CONFIG_EXFAT_FS=m
CONFIG_NLS_CODEPAGE_437=m
CONFIG_NLS_ISO8859_1=m
CONFIG_NLS_UTF8=m
CONFIG_FANOTIFY=y
CONFIG_AUTOFS_FS=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
