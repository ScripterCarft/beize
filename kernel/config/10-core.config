# Core kernel (ADR 0015). Base is alldefconfig (each option at its
# maintainer's default) plus the upstream hardening fragment; every option
# Beize relies on is listed in kernel/config. Reference for infrastructure: Fedora.

CONFIG_LOCALVERSION="-beize"
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_CC_OPTIMIZE_FOR_PERFORMANCE=y
# Patch branches at run time instead of testing flags (static keys)
CONFIG_JUMP_LABEL=y

# Scheduler: the scheduler decides when to preempt (upstream's default since
# PREEMPT_LAZY), switchable at boot; 1000 Hz for a responsive desktop; ticks
# stop on idle CPUs and, with nohz_full=, on busy ones. All as Fedora.
CONFIG_PREEMPT_LAZY=y
CONFIG_PREEMPT_DYNAMIC=y
CONFIG_HZ_1000=y
CONFIG_NO_HZ_FULL=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_SCHED_MC=y
CONFIG_SCHED_SMT=y
CONFIG_SCHED_CLUSTER=y
# Hybrid CPUs (P- and E-cores): favour the fastest cores
CONFIG_SCHED_MC_PRIO=y
# Utilization clamping: the foreground app gets priority (VISION)
CONFIG_UCLAMP_TASK=y
CONFIG_UCLAMP_TASK_GROUP=y

# Accounting systemd and tools read
CONFIG_TASKSTATS=y
CONFIG_TASK_DELAY_ACCT=y
CONFIG_TASK_XACCT=y
CONFIG_TASK_IO_ACCOUNTING=y
CONFIG_PSI=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y

# Control groups: systemd manages every service and session in its own
CONFIG_CGROUPS=y
CONFIG_MEMCG=y
CONFIG_BLK_CGROUP=y
CONFIG_CGROUP_SCHED=y
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_CFS_BANDWIDTH=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CPUSETS=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CGROUP_PERF=y
CONFIG_CGROUP_BPF=y
CONFIG_CGROUP_MISC=y

# Namespaces: service sandboxing in systemd, later app sandboxes
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_TIME_NS=y
CONFIG_IPC_NS=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y

# The kernel image compressed with zstd, as Fedora, Ubuntu and Arch. Measured
# in the VM (2026-10-12, firmware boot manager to initrd, 6 boots each): zstd
# 1.69 s, lz4 1.75, gzip (alldefconfig's) 1.76, lzo 1.92, xz 2.19, bzip2
# 2.40, lzma 2.60; zstd is also 1.2 MB smaller than gzip, which the firmware
# reads, hashes for Secure Boot and measures into the TPM.
CONFIG_KERNEL_ZSTD=y

# The UKI carries a zstd-compressed systemd initrd
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_ZSTD=y

# System calls and interfaces
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
CONFIG_WATCH_QUEUE=y
CONFIG_FHANDLE=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_BPF_JIT_ALWAYS_ON=y
CONFIG_BPF_UNPRIV_DEFAULT_OFF=y
CONFIG_PERF_EVENTS=y
CONFIG_KALLSYMS=y
CONFIG_INOTIFY_USER=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_COREDUMP=y
CONFIG_CORE_DUMP_DEFAULT_ELF_HEADERS=y
# process_vm_readv/writev for debuggers
CONFIG_CROSS_MEMORY_ATTACH=y
# 32-bit programs (games, Wine, older apps), as every desktop distribution
CONFIG_IA32_EMULATION=y

# Memory: multi-generational LRU, transparent and explicit huge pages on
# request, swap (how – zram or zswap – is decided with swap itself)
CONFIG_SWAP=y
CONFIG_HUGETLBFS=y
CONFIG_LRU_GEN=y
CONFIG_LRU_GEN_ENABLED=y
CONFIG_TRANSPARENT_HUGEPAGE=y
CONFIG_TRANSPARENT_HUGEPAGE_MADVISE=y
CONFIG_COMPACTION=y
CONFIG_MIGRATION=y

# Modules (ADR 0015): device drivers are modules, signed when the kernel is
# built with a key bz throws away afterwards (ML-DSA-87 as Fedora), and the
# kernel accepts no other. zstd-compressed, unpacked by the kernel.
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_MODULE_SIG=y
CONFIG_MODULE_SIG_FORCE=y
CONFIG_MODULE_SIG_ALL=y
CONFIG_MODULE_SIG_SHA512=y
CONFIG_MODULE_SIG_KEY="certs/signing_key.pem"
CONFIG_MODULE_SIG_KEY_TYPE_MLDSA_87=y
# OpenSSL before 4.0 cannot sign ML-DSA without authenticated attributes,
# which the kernel otherwise rejects (Fedora sets this for the same reason)
CONFIG_PKCS7_WAIVE_AUTHATTRS_REJECTION_FOR_MLDSA=y
CONFIG_MODULE_COMPRESS=y
CONFIG_MODULE_COMPRESS_ZSTD=y
CONFIG_MODULE_DECOMPRESS=y
# udev loads modules; nothing calls a helper program from the kernel
CONFIG_MODPROBE_PATH="/usr/bin/modprobe"
# CONFIG_UEVENT_HELPER is not set

# Firmware: from /usr/lib/firmware, zstd-compressed, never via a helper
CONFIG_FW_LOADER=y
CONFIG_FW_LOADER_COMPRESS=y
CONFIG_FW_LOADER_COMPRESS_ZSTD=y
# CONFIG_FW_LOADER_USER_HELPER is not set

# Diagnostics. Tracing (ftrace, kprobes, uprobes) for measuring with perf and
# BPF tools ("measure first"), as Fedora; dormant until used.
CONFIG_FTRACE=y
CONFIG_FUNCTION_TRACER=y
CONFIG_DYNAMIC_FTRACE=y
CONFIG_KPROBES=y
CONFIG_KPROBE_EVENTS=y
CONFIG_UPROBE_EVENTS=y
CONFIG_BPF_EVENTS=y
CONFIG_PERF_EVENTS_INTEL_UNCORE=m
CONFIG_PERF_EVENTS_INTEL_RAPL=m
CONFIG_PERF_EVENTS_INTEL_CSTATE=m
CONFIG_PERF_EVENTS_AMD_UNCORE=m
CONFIG_PRINTK_TIME=y
CONFIG_SYMBOLIC_ERRNAME=y
# Reports writable and executable kernel mappings at boot
CONFIG_DEBUG_WX=y
CONFIG_MAGIC_SYSRQ=y
CONFIG_MAGIC_SYSRQ_DEFAULT_ENABLE=0x0
