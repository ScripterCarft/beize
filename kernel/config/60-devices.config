# Console, input, USB and other devices (ADR 0015).

# Console: serial port (VMs, debugging) and the screen. The framebuffer the
# firmware set up (GOP) stays the console until a real GPU driver takes over,
# so everything early – the recovery-key prompt above all – is on the monitor.
CONFIG_TTY=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_UNIX98_PTYS=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_DRM=y
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FRAMEBUFFER_CONSOLE=y
# Console font: Terminus 16x32 next to the standard 8x16. The kernel picks the
# bigger one by itself on high resolutions (2560x1440: 160x45 characters instead
# of 320x90 too small to read), keeping 8x16 on small screens and in VMs.
CONFIG_FONTS=y
CONFIG_FONT_8x16=y
CONFIG_FONT_TER16x32=y
# QEMU's standard VGA
CONFIG_DRM_BOCHS=m
# The GPU VMs use today (libvirt, GNOME Boxes, UTM): virtio-gpu, as Fedora.
# Unlike the standard VGA it has a cursor plane and display hotplug, which
# Beize's compositor uses; the smoke test's VMs have it (ADR 0027 §6).
CONFIG_DRM_VIRTIO_GPU=m
# NVIDIA GPUs (the owner's RTX 3070 Ti): nouveau, as Fedora. From Turing on
# it runs NVIDIA's GSP firmware (linux-firmware) on the GPU, which does
# modesetting, clocks and power itself; Mesa's NVK sits on top (ADR 0027).
CONFIG_DRM_NOUVEAU=m

# Keyboard for the recovery key before udev: USB (xHCI) with HID built in, as
# Fedora; PS/2 too (VMs, older boards). Modules for the rest.
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_KEYBOARD_ATKBD=y
CONFIG_SERIO=y
CONFIG_SERIO_I8042=y
CONFIG_INPUT_MOUSE=y
CONFIG_MOUSE_PS2=m
CONFIG_INPUT_MISC=y
CONFIG_INPUT_UINPUT=m
CONFIG_HID_SUPPORT=y
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_USB_HID=y
# Raw HID access: security keys, headsets and other devices with own protocols
CONFIG_HIDRAW=y
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_PCI=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PCI=y
# AMD chipset quirks; devices stay the same across standby
CONFIG_USB_PCI_AMD=y
CONFIG_USB_DEFAULT_PERSIST=y

# Intel chipset (700 series and its relatives): Management Engine interface,
# SMBus, I2C controllers (LPSS), GPIO, telemetry
CONFIG_INTEL_MEI=m
CONFIG_INTEL_MEI_ME=m
# I2C core built in: DRM needs it
CONFIG_I2C=y
CONFIG_I2C_I801=m
CONFIG_MFD_INTEL_LPSS_PCI=m
CONFIG_I2C_DESIGNWARE_CORE=m
CONFIG_I2C_DESIGNWARE_PLATFORM=m
CONFIG_PINCTRL=y
CONFIG_PINCTRL_ALDERLAKE=m
CONFIG_X86_PLATFORM_DEVICES=y
CONFIG_INTEL_VSEC=m

# Sensors and power measurement: CPU temperatures, package power (RAPL)
CONFIG_HWMON=y
CONFIG_SENSORS_CORETEMP=m
CONFIG_THERMAL=y
CONFIG_THERMAL_HWMON=y
CONFIG_X86_PKG_TEMP_THERMAL=m
CONFIG_POWERCAP=y
CONFIG_INTEL_RAPL=m

# virtio devices in VMs
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO_PCI=m
CONFIG_HW_RANDOM_VIRTIO=m
# virtio's tablet and keyboard (libvirt, UTM): an absolute pointer, so the
# pointer in a VM window follows the host's, as Fedora (=m).
CONFIG_VIRTIO_INPUT=m
