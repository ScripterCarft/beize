# Which units of the image are enabled (ADR 0013). bz applies this at build
# time with Beize's own systemctl, together with systemd's defaults
# (90-systemd.preset) and "disable *" for everything else (99-beize.preset),
# and puts the resulting links into /usr: what runs is part of the signed
# image, /etc holds only the owner's changes. The first matching line wins,
# so this file overrides systemd's defaults – only with a reason.

# The system bus: dbus-broker (#32), as Fedora and Arch; its unit is
# dbus.service by alias.
enable dbus-broker.service

# Beize's own units.
enable beize-boot-chain.service
enable beize-boot-report.service
enable beize-save-clock.timer
enable beize-setup.service
# Accounts (ADR 0019): the account service, started per request.
enable beize-accounts.socket
# Updates (ADR 0020): the updater and its fetcher, started per request.
enable beize-update.socket
enable beize-update-fetch.socket
# Whether a boot succeeded, and the boot loader from such a boot (ADR 0020).
enable beize-boot-health.service
enable beize-boot-update.service
# The console keymap also for the initrd (ADR 0017).
enable beize-keymap.path
# Privileges (ADR 0018): polkit checks passwords in this sandboxed helper,
# one instance per request, instead of a setuid program. polkitd itself is
# started by D-Bus on first use.
enable polkit-agent-helper.socket
# Time with NTS (ADR 0012).
enable ntpd-rs.service

# systemd's boot loader update runs before sysinit.target, before a boot
# could prove itself; beize-boot-update.service does the same once it has
# (ADR 0020).
disable systemd-boot-update.service

# After an update systemd-sysupdate notifies systemd-pcrlock, which then
# writes a pcrlock policy as a credential onto the ESP. Beize seals the data
# with the signed PCR 11 policy instead (ADR 0009); systemd-stub measures
# that credential into PCR 12, so the next boot counted as changed and the
# data stayed locked (found by the update test, ADR 0020).
disable systemd-sysupdate-notify-pcrlock.socket
