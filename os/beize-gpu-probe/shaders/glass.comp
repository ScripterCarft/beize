#version 450
// Dual Kawase, up, straight into a panel of the desktop (the control centre):
// blurred, saturation lifted, lightly tinted.
layout(local_size_x = 16, local_size_y = 16) in;
layout(binding = 0) uniform sampler2D blur;
layout(binding = 1, rgba8) uniform image2D scene;
layout(push_constant) uniform Push { vec4 a; ivec4 panel; } p; // panel: x, y, width, height

void main() {
    ivec2 at = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(at, p.panel.zw))) return;
    ivec2 px = p.panel.xy + at;
    vec2 size = p.a.yz;
    vec2 uv = (vec2(px) + 0.5) / size;
    vec2 o = 1.5 / (size / 4.0);
    vec3 b = (texture(blur, uv + vec2(-o.x * 2.0, 0.0)).rgb
            + texture(blur, uv + vec2(-o.x, o.y)).rgb * 2.0
            + texture(blur, uv + vec2(0.0, o.y * 2.0)).rgb
            + texture(blur, uv + vec2(o.x, o.y)).rgb * 2.0
            + texture(blur, uv + vec2(o.x * 2.0, 0.0)).rgb
            + texture(blur, uv + vec2(o.x, -o.y)).rgb * 2.0
            + texture(blur, uv + vec2(0.0, -o.y * 2.0)).rgb
            + texture(blur, uv + vec2(-o.x, -o.y)).rgb * 2.0) / 12.0;
    b = mix(vec3(dot(b, vec3(0.299, 0.587, 0.114))), b, 1.4);
    b = mix(b, vec3(1.0), 0.25);
    imageStore(scene, px, vec4(b, 1.0));
}
