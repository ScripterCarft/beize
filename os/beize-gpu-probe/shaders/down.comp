#version 450
// Dual Kawase, down: half the resolution, five taps (VISION: live glass).
layout(local_size_x = 16, local_size_y = 16) in;
layout(binding = 0) uniform sampler2D src;
layout(binding = 1, rgba8) uniform writeonly image2D dst;

void main() {
    ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(dst);
    if (any(greaterThanEqual(px, size))) return;
    vec2 uv = (vec2(px) + 0.5) / vec2(size);
    vec2 h = 0.5 / vec2(size);
    vec4 s = texture(src, uv) * 4.0
           + texture(src, uv - h) + texture(src, uv + h)
           + texture(src, uv + vec2(h.x, -h.y)) + texture(src, uv - vec2(h.x, -h.y));
    imageStore(dst, px, s / 8.0);
}
