[Unit]
Description=Beize's compositor
Documentation=file:/usr/lib/beize/beize-compositor
# Part of the desktop that beize-session starts from a login (ADR 0027
# §6), which gives the session's id (libseat) through the environment.
RefuseManualStart=yes
PartOf=beize-session.target

[Service]
# When it ends, the session ends with it (no restart), as macOS logs out
# when the WindowServer dies; beize-session reports how it ended.
# Ready once it has a screen to show the desktop on: without one
# connected, it waits for one, as long as it takes (no start timeout).
Type=notify
TimeoutStartSec=infinity
ExecStart=/usr/lib/beize/beize-compositor
# Each buffer a client shares (dmabuf) and each client's connection is an
# open file: systemd's soft limit of 1024 (select(2)'s) ran out with one
# terminal's buffers (0.5.105), and every client failed with it. The hard
# limit for both, as Mutter, KWin and Sway raise theirs; the sandbox
# forbids setrlimit(2) (@resources), so the unit sets it. Apps are units
# of their own and keep 1024.
LimitNOFILE=524288
# What the session cannot do without (systemd.special(7)).
Slice=session.slice
# Sandbox (images/desktop/security.toml). The devices come from logind as
# open files, but Mesa opens the GPU's render node itself, hence no
# PrivateDevices; it writes only its socket in the runtime directory
# (ProtectHome=yes would hide that too, it is below /run/user). Netlink for
# udev's announcements
# of new devices, which also keep it in the host's network namespace.
# Lavapipe compiles its shaders to machine code, hence no
# MemoryDenyWriteExecute. Mesa keeps the compiled shaders in a cache
# directory of the compositor's own (~/.cache/beize-compositor, writable
# as the only place in the home), not in ~/.cache/mesa_shader_cache_db,
# which every app's Mesa shares. The appearance chosen in the control
# center is kept in ~/.config/beize (ConfigurationDirectory, writable too)
# until Beize's settings hold it.
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%t
CacheDirectory=beize-compositor
ConfigurationDirectory=beize
Environment=MESA_SHADER_CACHE_DIR=%C/beize-compositor
PrivateTmp=yes
PrivateUsers=self
ProtectProc=invisible
ProcSubset=pid
CapabilityBoundingSet=
NoNewPrivileges=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM
KeyringMode=private
UMask=0077
