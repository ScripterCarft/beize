[Unit]
Description=Update the boot loader from a successful boot
Documentation=man:bootctl(1)
# What systemd-boot-update.service does, but only once this boot succeeded
# (ADR 0020): a new boot loader has no previous version to fall back to.
# systemd's unit runs before sysinit.target, which boot-complete.target
# follows. bootctl takes the signed systemd-bootx64.efi.signed from /usr
# and replaces the one on the ESP only by a newer version. Then the boot
# loader's configuration of this version (loader.conf, ADR 0024).
# No default dependencies: multi-user.target must not wait for it (it is
# ordered after boot-complete.target, which is after multi-user.target).
DefaultDependencies=no
ConditionFirmware=uefi
Requires=boot-complete.target
After=local-fs.target boot-complete.target
Conflicts=shutdown.target
Before=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=bootctl --variables=no --graceful update
ExecStart=/usr/lib/beize/loader-conf
# Sandbox (images/security.toml): it writes systemd-boot to the ESP, which
# it finds by its block device.
ProtectSystem=strict
ReadWritePaths=-/efi -/boot
CapabilityBoundingSet=
ProtectKernelTunables=yes
ProtectProc=invisible
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=yes
NoNewPrivileges=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
UMask=0077

[Install]
WantedBy=multi-user.target
