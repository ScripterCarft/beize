[Unit]
Description=Beize's updater, one request
Documentation=file:/usr/lib/beize/beize-updated

[Service]
ExecStart=/usr/lib/beize/beize-updated
StandardInput=socket
StandardOutput=journal
StandardError=journal
# Its checked copy of a release and the lock (/var/lib/beize-update).
StateDirectory=beize-update
StateDirectoryMode=0700
# No network: beize-update-fetch fetches. systemd-sysupdate runs as its
# child and writes the free /usr slot (a block device) and the ESP; the
# capabilities are those of systemd's own systemd-sysupdate.service.
CapabilityBoundingSet=CAP_CHOWN CAP_FOWNER CAP_FSETID CAP_MKNOD CAP_SETFCAP CAP_SYS_ADMIN CAP_SETPCAP CAP_DAC_OVERRIDE CAP_LINUX_IMMUTABLE
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/boot -/efi
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=net mnt
RestrictRealtime=yes
RestrictSUIDSGID=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service @mount
SystemCallErrorNumber=EPERM
