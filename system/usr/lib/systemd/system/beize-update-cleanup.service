[Unit]
Description=Clear what an interrupted update left
Documentation=file:/usr/lib/beize/beize-updated
# Power gone while an update writes leaves a slot of a type of its own, which
# systemd-repart takes for a missing /usr: it then fails every start, and the
# start never counts as good (ADR 0020). systemd-sysupdate's vacuum removes
# only what is partial or beyond InstancesMax, in about 10 ms.
DefaultDependencies=no
# Early: repart comes before local-fs.target (systemd-growfs-root). Root is
# mounted by now, and the ESP comes with its automount.
After=systemd-remount-fs.service boot.automount systemd-udev-trigger.service
Before=sysinit.target shutdown.target
Conflicts=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/lib/systemd/systemd-sysupdate --no-pager vacuum
# Sandbox (images/security.toml), as beize-update@.service: it writes the free
# /usr slot and the ESP.
CapabilityBoundingSet=CAP_CHOWN CAP_FOWNER CAP_FSETID CAP_MKNOD CAP_SETFCAP CAP_SYS_ADMIN CAP_SETPCAP CAP_DAC_OVERRIDE CAP_LINUX_IMMUTABLE
NoNewPrivileges=yes
ProtectSystem=strict
# No StateDirectory= and no plain PrivateTmp=: each orders after tmpfiles, and
# that after local-fs.target, which comes after repart.
ReadWritePaths=/boot -/efi -/var/lib/systemd/sysupdate
ProtectHome=yes
PrivateTmp=disconnected
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=net mnt
RestrictRealtime=yes
RestrictSUIDSGID=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service @mount
SystemCallErrorNumber=EPERM

[Install]
WantedBy=sysinit.target
