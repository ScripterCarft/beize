[Unit]
Description=Set up the keyboard and the owner's account
Documentation=file:/usr/lib/beize/beize-setup
# Once per installation, before anyone can log in. Replaced by the graphical
# onboarding later.
ConditionPathExists=!/var/lib/beize/owner
After=systemd-sysusers.service local-fs.target systemd-mute-console.socket
# The account is created by Beize's account service (ADR 0019).
Requires=beize-accounts.socket
After=beize-accounts.socket systemd-tmpfiles-setup.service
Before=systemd-user-sessions.service getty@tty1.service serial-getty@ttyS0.service
# Should the setup still fail, it starts again: the start job stays pending
# meanwhile, so no login appears without an account.
StartLimitIntervalSec=0

[Service]
Type=oneshot
RemainAfterExit=yes
Restart=on-failure
RestartSec=2s
ExecStart=/usr/lib/beize/beize-setup owner
StandardInput=tty
StandardOutput=tty
StandardError=journal+console
TTYPath=/dev/console
TTYReset=yes
# Sandbox (images/security.toml): it asks on the console, sets keyboard and
# time zone through localed and timedated, the account through
# beize-accountsd, and writes /etc (time zone, root's shadow entry) and
# its marker in /var/lib/beize.
ProtectSystem=strict
ReadWritePaths=/etc /var/lib/beize
CapabilityBoundingSet=CAP_DAC_OVERRIDE CAP_FOWNER CAP_CHOWN
ProtectKernelTunables=yes
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=yes
NoNewPrivileges=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
UMask=0077

[Install]
WantedBy=multi-user.target
