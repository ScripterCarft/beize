[Unit]
Description=Log the critical chain of the boot
Documentation=file:/usr/lib/beize/boot-chain

[Service]
# exec: counts as started immediately, so the script can wait for the end of
# the boot transaction it is part of; it delays nothing.
Type=exec
ExecStart=/usr/lib/beize/boot-chain
SyslogIdentifier=beize-boot-chain
# Sandbox (images/security.toml): it only asks systemd over D-Bus, as a
# user of its own for the time it runs.
DynamicUser=yes
ProtectSystem=strict
CapabilityBoundingSet=
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectProc=invisible
ProcSubset=pid
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=yes
NoNewPrivileges=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
UMask=0077

[Install]
WantedBy=multi-user.target
