[Unit]
Description=Network time with NTS (ntpd-rs)
Documentation=man:ntp-daemon(8) file:/usr/lib/ntpd-rs/ntp.toml
# Nothing waits for the network during boot (ADR 0011); ntpd-rs retries its
# sources until the network is there.
After=network.target nss-lookup.target
Before=time-set.target time-sync.target
Wants=time-sync.target

[Service]
Type=notify
# Configuration: /etc/ntpd-rs/ntp.toml, a link to /usr/lib/ntpd-rs/ntp.toml
# unless the owner replaced it (tmpfiles.d/beize.conf).
ExecStart=/usr/bin/ntp-daemon
# No automatic restart, as upstream's hardening guide advises: every start
# allows one large clock step, so restarts could add up an attacker's
# steps. A stopped ntpd-rs shows as a failed unit; the next boot restarts it.
Restart=no
# An unprivileged user of its own; the only privilege: setting the clock.
DynamicUser=yes
RuntimeDirectory=ntpd-rs
AmbientCapabilities=CAP_SYS_TIME
CapabilityBoundingSet=CAP_SYS_TIME
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectHostname=yes
# As upstream's docs/examples/conf/ntpd-rs.strict.service: netlink lists the
# network interfaces (without it ntp-daemon exits at once).
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@basic-io @clock @file-system @io-event @network-io @process @signal ioctl madvise

[Install]
WantedBy=multi-user.target
