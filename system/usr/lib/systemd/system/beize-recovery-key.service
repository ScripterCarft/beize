[Unit]
Description=Create the recovery key for the encrypted root partition
# Only where the data is encrypted; the script itself skips volumes that
# already have a recovery key, so this runs for real once per installation.
ConditionPathIsEncrypted=/var
After=local-fs.target tpm2.target
# Shown before anyone can log in.
Before=systemd-user-sessions.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/lib/beize/recovery-key
# The key goes to the console only, never to the journal.
StandardOutput=tty
TTYPath=/dev/console
StandardError=journal

[Install]
WantedBy=multi-user.target
