[Unit]
Description=Keep the console keymap for the initrd
Documentation=file:/usr/lib/beize/beize-tpm
# Copies KEYMAP= of /etc/vconsole.conf into the EFI variable the initrd reads
# (beize-tpm keymap, ADR 0017); written only when it differs.
# No start limit: the first boot's setup writes vconsole.conf several times
# within seconds (localed), and five triggers in 10 s failed the default
# limit. Nothing can loop – this never writes vconsole.conf – and the path
# unit keeps its own trigger limit.
StartLimitIntervalSec=0

[Service]
Type=oneshot
ExecStart=/usr/lib/beize/beize-tpm keymap save
# Sandbox (images/security.toml): it writes one EFI variable, whose file
# efivarfs marks immutable (hence CAP_LINUX_IMMUTABLE).
ProtectSystem=strict
ReadWritePaths=/sys/firmware/efi/efivars
CapabilityBoundingSet=CAP_LINUX_IMMUTABLE
PrivateDevices=yes
ProtectProc=invisible
ProcSubset=pid
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=yes
NoNewPrivileges=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
UMask=0077
