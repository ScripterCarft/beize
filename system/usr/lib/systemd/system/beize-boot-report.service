[Unit]
Description=Report the boot outcome on the console
# Test hook: only when bz smoke passes the credential (SMBIOS type 11). Images
# for real hardware import no credentials at all (systemd.import_credentials=no).
ConditionCredential=beize.smoke

[Service]
# exec: counts as started immediately, so the script can wait for the end of
# the boot transaction it is part of.
Type=exec
ExecStart=/usr/lib/beize/boot-report
StandardOutput=tty
TTYPath=/dev/console

[Install]
WantedBy=multi-user.target
