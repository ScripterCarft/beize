#!/usr/bin/bash
# Reports the outcome of the boot on the console once systemd has finished
# starting up. `bz smoke` evaluates this line; when the beize.smoke credential
# is present (passed by `bz smoke` via SMBIOS) the machine powers off afterwards.
set -u

state=$(systemctl is-system-running --wait)
read -r uptime _ < /proc/uptime

# The phases of the boot in µs, as systemd measured them (the numbers of
# "Startup finished"): `bz smoke` holds them to a time budget. The initrd
# began when the kernel handed over, the system at the switch to the real
# root. 0 = not measured.
kernel=0 initrd=0 userspace=0
stamps=()
while read -r _ value; do
    stamps+=("$value")
done < <(busctl get-property org.freedesktop.systemd1 /org/freedesktop/systemd1 \
    org.freedesktop.systemd1.Manager InitRDTimestampMonotonic \
    UserspaceTimestampMonotonic FinishTimestampMonotonic)
if ((${#stamps[@]} == 3 && stamps[0] > 0 && stamps[1] > stamps[0] && stamps[2] > stamps[1])); then
    kernel=${stamps[0]}
    initrd=$((stamps[1] - stamps[0]))
    userspace=$((stamps[2] - stamps[1]))
fi

# EFI variable SecureBoot: 4 attribute bytes, then 1 = enabled.
secureboot=off
sb_var=/sys/firmware/efi/efivars/SecureBoot-8be4df61-93ca-11d2-aa0d-00e098032b8c
if [[ -r $sb_var ]] && [[ $(od -An -tu1 -j4 -N1 "$sb_var") -eq 1 ]]; then
    secureboot=on
fi

# Shadow stack (ADR 0014): "on" if PID 1 runs with one – kernel, glibc and
# systemd all support it; "nohw" if the CPU has none (e.g. a VM whose
# hypervisor hides CET), "off" otherwise.
shstk=nohw
while IFS=: read -r key value; do
    if [[ $key == flags* ]]; then
        [[ " $value " == *" shstk "* ]] && shstk=off
        break
    fi
done < /proc/cpuinfo
if [[ $shstk == off ]]; then
    while IFS=: read -r key value; do
        [[ $key == x86_Thread_features && " $value " == *" shstk "* ]] && shstk=on
    done < /proc/1/status
fi

# Kernel (ADR 0015). Lockdown: the active mode is the one in brackets.
lockdown=none
if [[ -r /sys/kernel/security/lockdown ]]; then
    read -r line < /sys/kernel/security/lockdown
    [[ $line =~ \[([a-z]+)\] ]] && lockdown=${BASH_REMATCH[1]}
fi
# Module signatures: `bz smoke` passes a module as the compiler wrote it,
# unsigned, through QEMU's fw_cfg. The kernel must refuse it – and load the
# same module from the image, where it is signed.
unsigned=none signed=none
fw_cfg=/sys/firmware/qemu_fw_cfg/by_name/opt/org.beize/unsigned-module/raw
if [[ -r $fw_cfg ]]; then
    cp "$fw_cfg" /run/beize-unsigned.ko
    if error=$(insmod /run/beize-unsigned.ko 2>&1); then
        unsigned=loaded
        rmmod nls_utf8
    elif [[ $error == *"Key was rejected by service"* ]]; then
        unsigned=refused
    else
        unsigned=error
        echo "BEIZE-MODULE-PROBE ${error//$'\n'/ | }"
    fi
    rm -f /run/beize-unsigned.ko
    signed=failed
    modprobe nls_utf8 && signed=loaded && modprobe --remove nls_utf8
fi
# Every PCI device has a driver – udev loaded the modules for what the machine
# has – apart from bridges (class 06xx), which the PCI core handles itself.
nodriver=()
for device in /sys/bus/pci/devices/*; do
    read -r class < "$device/class"
    [[ $class == 0x06* || -e $device/driver ]] && continue
    read -r vendor < "$device/vendor"
    read -r id < "$device/device"
    nodriver+=("${vendor#0x}:${id#0x}")
done

# How /usr and / are mounted, judged by the device-mapper target below them:
# /usr is "verity" only if every block read is checked against the root hash
# in the signed UKI; / is "encrypted" only if it lives on a LUKS2 volume.
usr=unprotected
root=plain
while read -r _ _ devnum _ mountpoint _; do
    dm_uuid=/sys/dev/block/$devnum/dm/uuid
    [[ -r $dm_uuid ]] || continue
    case $mountpoint:$(< "$dm_uuid") in
        /usr:CRYPT-VERITY-*) usr=verity ;;
        /:CRYPT-LUKS2-*) root=encrypted ;;
    esac
done < /proc/self/mountinfo

# The TPM must not unlock the root partition from the running system: its
# slot is bound to the initrd phase only (ADR 0010). "refused" only if
# systemd-cryptsetup found no signed PCR 11 policy for this phase;
# "notbound" if this TPM cannot even load the volume's key (another TPM);
# any other failure (no TPM, missing library, ...) proves nothing: "unknown".
systemunlock=none
mapper=$(readlink -f /dev/mapper/root 2>/dev/null)
if [[ $root == encrypted && -n $mapper ]]; then
    for slave in "/sys/block/${mapper##*/}/slaves/"*; do
        luks=/dev/${slave##*/}
    done
    if probe=$(systemd-cryptsetup attach beize-probe "$luks" - \
            tpm2-device=auto,headless=true,readonly 2>&1); then
        systemunlock=possible
        systemd-cryptsetup detach beize-probe
    elif [[ $probe == *"No signature for current PCR policy"*"token does not apply to current boot state"* ]]; then
        systemunlock=refused
    elif [[ $probe == *"Esys_Load"*"TPM Error"* ]]; then
        systemunlock=notbound
    else
        systemunlock=unknown
        echo "BEIZE-UNLOCK-PROBE ${probe//$'\n'/ | }"
    fi
fi

# Network (ADR 0011): nothing in the boot waits for it, so wait here (after
# reading the uptime). "routable" = an address and a default route; dns = the
# servers resolved learned from the network; lookup = a name resolved through
# NSS (nss-resolve synthesizes _gateway), as every program resolves names.
network=timeout
if /usr/lib/systemd/systemd-networkd-wait-online --operational-state=routable --timeout=30; then
    read -r _ network < <(busctl get-property org.freedesktop.network1 /org/freedesktop/network1 \
        org.freedesktop.network1.Manager OperationalState)
    network=${network//\"/}
fi
dns=()
upstream=/run/systemd/resolve/resolv.conf
if [[ -r $upstream ]]; then
    while read -r key value _; do
        [[ $key == nameserver ]] && dns+=("$value")
    done < "$upstream"
fi
dns_list=$(IFS=,; echo "${dns[*]}")
# All addresses: the gateway has an IPv4 and an IPv6 address, in no fixed
# order.
lookup=()
while read -r address _; do
    [[ " ${lookup[*]} " == *" $address "* ]] || lookup+=("$address")
done < <(getent ahosts _gateway)
lookup_list=$(IFS=,; echo "${lookup[*]}")

# Time (ADR 0012): the zone chosen in the setup, and how many time servers
# completed the NTS key exchange (DNS, TLS with the root certificates, NTS
# cookies). Setting the clock takes ntpd-rs ~2 minutes (8 samples per
# source), too long to wait for here. Needs the internet: waits a little.
tz=$(readlink /etc/localtime)
tz=${tz#*/zoneinfo/}
# Keyboard (ADR 0017): the console keymap the setup chose, and what the key
# between T and U gives on the console – z with a German keymap, y with the
# kernel's US one – so the keymap is not only configured but loaded.
keymap=none
if [[ -r /etc/vconsole.conf ]]; then
    while IFS= read -r line; do
        [[ $line == KEYMAP=* ]] && keymap=${line#KEYMAP=}
    done < /etc/vconsole.conf
fi
yzkey=unknown
while read -r word number equals symbol _; do
    [[ $word == keycode && $number == 21 && $equals == "=" ]] && yzkey=${symbol#+}
done < <(dumpkeys --console=/dev/tty1 --keys-only 2>/dev/null)
# The keymap kept for the initrd (beize-tpm keymap): 4 attribute bytes, then
# the name.
efikeymap=none
efikeymap_var=/sys/firmware/efi/efivars/BeizeKeymap-e6e221d0-db73-4fa8-99da-ba41e1b78888
[[ -r $efikeymap_var ]] && efikeymap=$(tail -c +5 "$efikeymap_var")
# The system clock (seconds since 1970): `bz smoke` checks it after a reset
# hardware clock.
printf -v clock '%(%s)T' -1
nts=0
if [[ $network == routable ]]; then
    for _ in {1..20}; do
        nts=0
        while IFS= read -r line; do
            [[ $line == *"NTS cookies:"* && $line != *"	0/"* ]] && nts=$((nts + 1))
        done < <(ntp-ctl status 2>/dev/null)
        ((nts >= 3)) && break
        sleep 0.5
    done
fi

# Lines beize-boot-chain wrote into the journal in this boot: the critical
# chain `bz boot-times` shows. It starts with this script; wait until it is
# done.
for _ in {1..40}; do
    [[ $(systemctl show --property=ActiveState --value beize-boot-chain.service) == active ]] || break
    sleep 0.25
done
# --quiet: without it, "-- No entries --" would count as a line.
chain=0
while read -r _; do
    chain=$((chain + 1))
done < <(journalctl --boot --identifier=beize-boot-chain --output=cat --no-pager --quiet)

failed=()
while read -r unit _; do
    failed+=("$unit")
done < <(systemctl list-units --failed --plain --no-legend)
failed_list=$(IFS=,; echo "${failed[*]}")

# Units whose start failed at any time in this boot, the initrd included:
# the job results the console shows as [FAILED] and [DEPEND] – but also
# while the console was muted (recovery key, setup), and after the initrd,
# whose units the list above no longer knows.
boot_failed=()
while IFS= read -r line; do
    [[ $line == UNIT=* ]] || continue
    unit=${line#UNIT=}
    [[ " ${boot_failed[*]} " == *" $unit "* ]] || boot_failed+=("$unit")
done < <(journalctl --boot JOB_RESULT=failed JOB_RESULT=dependency \
    --output=export --output-fields=UNIT --no-pager)
boot_failed_list=$(IFS=,; echo "${boot_failed[*]}")

# Boots of this installation, counted on the root partition: proves that the
# root partition (/etc, /var) survives a reboot.
counter=/var/lib/beize/boot-count
boot=0
[[ -r $counter ]] && read -r boot < "$counter"
boot=$((boot + 1))
mkdir -p "${counter%/*}" && echo "$boot" > "$counter" && sync "$counter"
read -r machineid < /etc/machine-id

# What runs (ADR 0013): the active services, sockets, timers and paths, and
# the unit links in /etc – what the image enables lives in /usr, so /etc
# holds only the owner's changes. `bz smoke` compares both with what it
# expects. Before the report, which ends the test's wait.
units=()
while read -r unit _; do
    units+=("$unit")
done < <(systemctl list-units --type=service,socket,timer,path --state=active --no-legend --plain)
etc_links=()
shopt -s globstar nullglob
for link in /etc/systemd/system/** /etc/systemd/user/**; do
    [[ -L $link ]] && etc_links+=("${link#/etc/systemd/}")
done
shopt -u globstar nullglob
echo "BEIZE-UNITS etc=$(IFS=,; echo "${etc_links[*]:-none}") active=$(IFS=,; echo "${units[*]}")"

echo "BEIZE-BOOT-REPORT state=${state} secureboot=${secureboot} usr=${usr} root=${root} boot=${boot}" \
     "machineid=${machineid} uptime=${uptime}s systemunlock=${systemunlock}" \
     "network=${network} dns=${dns_list:-none} lookup=${lookup_list:-none}" \
     "tz=${tz:-none} keymap=${keymap} yzkey=${yzkey} efikeymap=${efikeymap:-none} nts=${nts} clock=${clock}" \
     "kernel=${kernel} initrd=${initrd} userspace=${userspace} chain=${chain} shstk=${shstk}" \
     "lockdown=${lockdown} unsigned=${unsigned} signed=${signed}" \
     "nodriver=$(IFS=,; echo "${nodriver[*]:-none}")" \
     "failed=${failed_list:-none} bootfailed=${boot_failed_list:-none}"

# The journal of every failed unit, so a failed test run explains itself.
for unit in "${failed[@]}" "${boot_failed[@]}"; do
    while IFS= read -r line; do
        echo "BEIZE-FAILED-LOG ${unit}: ${line}"
    done < <(journalctl --boot --unit="$unit" --output=cat --no-pager --lines=30)
done

if [[ -e /run/credentials/@system/beize.smoke ]]; then
    # The journal of this boot for `bz boot-times`, on the second serial port
    # (`bz smoke` keeps what follows the marker – the firmware writes there,
    # too – in a file next to the console log): only the fields it reads,
    # from the system manager, the kernel and beize-boot-chain. raw: no CR
    # before each newline; no colours, which journalctl adds on a terminal.
    if stty -F /dev/ttyS1 raw 2> /dev/null; then
        {
            echo BEIZE-JOURNAL
            SYSTEMD_COLORS=0 journalctl --boot --output=json --no-pager \
                --output-fields=_SOURCE_MONOTONIC_TIMESTAMP,SYSLOG_IDENTIFIER,_TRANSPORT,_PID,SYSLOG_PID,MESSAGE,MESSAGE_ID,UNIT,KERNEL_USEC,INITRD_USEC,USERSPACE_USEC \
                _PID=1 + _TRANSPORT=kernel + SYSLOG_IDENTIFIER=beize-boot-chain
        } > /dev/ttyS1
    fi
    systemctl poweroff --no-block
fi
