#!/usr/bin/bash
# Reports the outcome of the boot on the console once systemd has finished
# starting up. `bz smoke` evaluates this line; when the beize.smoke credential
# is present (passed by `bz smoke` via SMBIOS) the machine powers off afterwards.
set -u

state=$(systemctl is-system-running --wait)
read -r uptime _ < /proc/uptime

# EFI variable SecureBoot: 4 attribute bytes, then 1 = enabled.
secureboot=off
sb_var=/sys/firmware/efi/efivars/SecureBoot-8be4df61-93ca-11d2-aa0d-00e098032b8c
if [[ -r $sb_var ]] && [[ $(od -An -tu1 -j4 -N1 "$sb_var") -eq 1 ]]; then
    secureboot=on
fi

# How /usr is mounted: "verity" only if it comes from a dm-verity device,
# i.e. every block read is checked against the root hash in the signed UKI.
usr=unprotected
while read -r _ _ devnum _ mountpoint _; do
    if [[ $mountpoint == /usr ]]; then
        dm_uuid=/sys/dev/block/$devnum/dm/uuid
        [[ -r $dm_uuid && $(< "$dm_uuid") == CRYPT-VERITY-* ]] && usr=verity
        break
    fi
done < /proc/self/mountinfo

failed=()
while read -r unit _; do
    failed+=("$unit")
done < <(systemctl list-units --failed --plain --no-legend)
failed_list=$(IFS=,; echo "${failed[*]}")

# Boots of this installation, counted on the root partition: proves that the
# root partition (/etc, /var) survives a reboot.
counter=/var/lib/beize/boot-count
boot=0
[[ -r $counter ]] && read -r boot < "$counter"
boot=$((boot + 1))
mkdir -p "${counter%/*}" && echo "$boot" > "$counter" && sync "$counter"
read -r machineid < /etc/machine-id

echo "BEIZE-BOOT-REPORT state=${state} secureboot=${secureboot} usr=${usr} boot=${boot}" \
     "machineid=${machineid} uptime=${uptime}s failed=${failed_list:-none}"

if [[ -e /run/credentials/@system/beize.smoke ]]; then
    systemctl poweroff --no-block
fi
