[Unit]
Description=Bind the encrypted root partition to the current boot state
# After an unlock with the recovery key (the TPM refused): see the script.
DefaultDependencies=no
ConditionPathExists=/etc/initrd-release
Requires=systemd-cryptsetup@root.service
After=systemd-cryptsetup@root.service systemd-ask-password.socket
Before=beize-recovery-key.service initrd-root-fs.target initrd-switch-root.target
Conflicts=initrd-switch-root.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/lib/beize/tpm-reseal
StandardOutput=tty
TTYPath=/dev/console
StandardError=journal+console
