#!/usr/bin/bash
# Binds the TPM slot of the root partition to the current boot state after the
# owner unlocked it with the recovery key – the BitLocker model (ADR 0010).
#
# The TPM refuses when PCR 7 changed (Windows installed a Secure Boot update,
# firmware update, keys re-enrolled) or the TPM itself is new (mainboard).
# Whoever knows the recovery key may approve the new state; from the next boot
# on the TPM unlocks by itself again. Never with Secure Boot off: that state
# must not be approved.
set -euo pipefail
source /usr/lib/beize/luks.sh

# systemd-cryptsetup keeps a typed passphrase in the kernel keyring
# "cryptsetup" for 2.5 min. Timeout 0 asks the cache only, never the user, so
# after a TPM unlock this finds nothing and the script ends here.
reply=$(varlinkctl call /run/systemd/io.systemd.AskPassword io.systemd.AskPassword.Ask \
    '{"keyname":"cryptsetup","acceptCached":true,"timeoutUSec":0}' 2>/dev/null) || exit 0
[[ $reply =~ \"passwords\"[^\"]*\"([^\"]+)\" ]] || exit 0
recovery_key=${BASH_REMATCH[1]}

if ! secure_boot_on; then
    echo "Secure Boot is off: the TPM stays bound to the previous state." >&2
    exit 0
fi

device=$(root_luks_device)
echo "The security chip did not recognise this computer's state (firmware or"
echo "Secure Boot changed); binding the data to the current state."
# Wipe first, then enroll: on a new TPM the PCR values are the same as before,
# and systemd-cryptenroll would take the old slot for current ("already
# enrolled") and do nothing at all. Should enrolling fail, the recovery key
# still opens the data and the next boot tries again.
systemd-cryptenroll --unlock-key-file=<(printf '%s' "$recovery_key") \
    --wipe-slot=tpm2 "$device"
# The signed PCR 11 policy (public key from the UKI) with reference "initrd",
# as systemd-repart enrolls it on first boot (system/initrd drop-in).
systemd-cryptenroll --unlock-key-file=<(printf '%s' "$recovery_key") \
    --tpm2-device=auto --tpm2-pcrs=7 --tpm2-public-key-policyref=initrd "$device"
