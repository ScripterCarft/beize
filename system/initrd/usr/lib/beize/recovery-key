#!/usr/bin/bash
# Creates the recovery key for the encrypted root partition and shows it once.
# Runs in the initrd, the only place where the TPM unlocks the root partition
# (ADR 0009, ADR 0010); the recovery key is the way back in when the TPM
# refuses: firmware update, new Secure Boot keys, replaced mainboard or
# broken TPM.
#
# The key is never written to disk or to the journal: it goes to the console
# and to /run/beize/recovery-key (memory only, survives the switch to the
# system, gone after the next restart). A lost key can be replaced from the
# running system with the old one:
#   systemd-cryptenroll --wipe-slot=recovery --recovery-key <root partition>
set -euo pipefail
source /usr/lib/beize/luks.sh

device=$(root_luks_device)

while read -r _ type; do
    [[ $type == recovery ]] && exit 0
done < <(systemd-cryptenroll "$device")

umask 077
# /run/beize comes from RuntimeDirectory= and outlives the initrd.
key_file=/run/beize/recovery-key
# Only the key goes to stdout. stderr carries the messages around it – and,
# when interactive, a QR code of the key – so it is shown only on failure and
# never reaches the journal.
if ! errors=$(systemd-cryptenroll --unlock-tpm2-device=auto --recovery-key "$device" \
        2>&1 > "$key_file"); then
    echo "$errors" >&2
    exit 1
fi
read -r key < "$key_file"

# Mute kernel and service manager output on the console while the key is on
# screen (systemd-mute-console, as systemd-firstboot does): the call stays open
# as long as varlinkctl runs, and its first reply means "muted". Then clear.
coproc MUTE { exec varlinkctl call --more /run/systemd/io.systemd.MuteConsole \
    io.systemd.MuteConsole.Mute '{}' 2>/dev/null; }
read -r -t 5 _ <&"${MUTE[0]}" || true
trap 'kill "$MUTE_PID" 2>/dev/null' EXIT
printf '\e[H\e[2J'

while IFS= read -r line; do
    echo "$line"
done <<MESSAGE

  ==================================================================
   Recovery key for the data on this computer

       ${key}

   This computer unlocks its data by itself, with its security chip
   (TPM). If that ever fails - after a firmware update, new Secure
   Boot keys or a new mainboard - this key is the only way back to
   your files. Write it down or keep it in your password manager,
   not on this computer.

   It is shown only now; until the next restart it is also in
   /run/beize/recovery-key.
  ==================================================================

MESSAGE

# The boot waits until the owner confirms: on real hardware the login prompt
# would otherwise clear the screen a moment later (BitLocker asks the same).
# A plain Enter is not enough, so nobody skips it by accident.
question="Type saved once the recovery key is written down:"
until [[ $(systemd-ask-password --echo=yes --timeout=0 --id=beize-recovery-key "$question") == saved ]]; do
    :
done
